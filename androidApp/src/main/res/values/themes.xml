<resources>
    <style name="Theme.Wassertiger" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF121417</item>
        <item name="android:statusBarColor">#FF121417</item>
        <item name="android:navigationBarColor">#FF121417</item>
    </style>

    <style name="Theme.Wassertiger.Flash" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">#FFFFB300</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="WidgetButton">
        <item name="android:layout_height">32dp</item>
        <item name="android:background">@drawable/widget_button_outline</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#FFFFB300</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
